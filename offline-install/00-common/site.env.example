#---------------------------------------------------------------------
# 사이트별 설정 — 환경마다 다른 값
#
# 이 파일은 예시다. 최초 1회 복사해서 자신의 환경 값으로 채운다.
#
#   cp 00-common/site.env.example 00-common/site.env
#   vi 00-common/site.env
#
# site.env 는 .gitignore 대상이다. 내부 IP·사내 호스트명이 들어가므로
# 공개 저장소에 올리지 않는다. versions.env 가 시작 시 이 파일을 source 하고,
# site.env 가 없으면 아래 예시 값으로 동작하면서 경고를 낸다.
#
# 번들에는 site.env 가 포함된다(build-bundle.sh 가 복사한다). 에어갭 타깃에서
# 값을 다시 입력할 필요가 없다는 뜻이다. 번들 자체가 사내 자산이므로 문제되지 않는다.
#
# 서비스 포트(*_PORT)는 호스트에 노출하는 포트만 바꾼다. 컨테이너 안의 포트는 그대로다.
# 기본값에서 바꾸면 UiPath AS input.json 등 외부 설정도 함께 바꿔야 한다
# (offline-install/README.md 2.1절 "서비스 포트를 바꿀 때").
#---------------------------------------------------------------------

#--- 내부망 대역 -------------------------------------------------------
# 에어갭 판정에서 "인터넷이 아닌 사내망"으로 간주해 허용할 대역.
# NFS export 허용 범위(setup-nfs-server.sh)의 기본값으로도 쓰인다.
SITE_PRIVATE_CIDR="10.0.0.0/16"

#--- NFS 서버 ----------------------------------------------------------
# k8s 노드 밖에 두는 것을 권장한다. 단일 노드에서 스토리지와 워크로드가
# 같은 장애 도메인에 묶이는 것을 피하기 위함이다(50-nfs-csi/README.md 1절).
NFS_SERVER_HOST="10.0.0.10"
# NFS 서버 데이터 디스크/LVM 마운트 지점. 설치 스크립트가 실제 마운트 여부를 확인한다.
NFS_MOUNT_PATH="/data/nfs"
# 클라이언트에 공개할 서버 경로. 마운트 지점과 같거나 그 하위여야 한다.
NFS_EXPORT_PATH="/data/nfs"
# export 접근 허용 대역. 생략하면 SITE_PRIVATE_CIDR 을 사용한다.
#NFS_ALLOWED_CIDR="10.0.0.0/16"

#--- 사내 Harbor (이미 운영 중인 레지스트리) ---------------------------
# 에어갭 노드는 사설 IP 로 접근하되, TLS SAN 때문에 호스트명을 써야 한다.
# 공인 DNS 는 공인 IP 를 반환해 차단되므로 /etc/hosts 에 아래 매핑을 넣는다.
HARBOR_HOSTNAME="harbor.example.internal"
HARBOR_PRIVATE_IP="10.0.0.10"

#--- 사내망 도달 확인 대상 --------------------------------------------
# airgap-on.sh 가 "인터넷은 막혔고 사내망은 열렸다"를 확인할 때 쓰는 주소.
# 비워 두면 해당 확인을 생략한다.
SITE_REACHABILITY_HOST="${HARBOR_PRIVATE_IP}"
SITE_REACHABILITY_PORT="443"

#--- MinIO (20-minio) --------------------------------------------------
# 클라이언트가 접속할 이름. 인증서 SAN 에 들어가므로 실제 접속에 쓰는 이름을
# 적어야 한다. 비워 두면 minio.<도메인> 을 추정해 쓴다.
MINIO_HOSTNAME="minio.example.internal"
# 비워 두면 install.sh 가 무작위 생성해 /opt/minio/minio.env(0600)에 저장한다.
# 공개 저장소에 기본 비밀번호를 적어두면 그대로 운영에 들어가므로 비워 둔다.
MINIO_ROOT_USER="uipathadmin"
MINIO_ROOT_PASSWORD=""
MINIO_HOST_IP=""
# 호스트에서 노출할 S3 API(HTTPS) 포트 (기본 9000). 컨테이너 안의 MinIO 는 9000 그대로다.
# 웹 콘솔은 9001 고정이다. 이미 설치된 서버에서 바꾸면 install.sh 가 /opt/minio/minio.env 의
# MINIO_SERVER_URL 포트만 새 값으로 고치고 백업(minio.env.bak.<시각>)을 남긴다.
MINIO_PORT="9000"


#--- SEAWEEDFS (21-seaweedfs) ------------------------------------------
# 클라이언트가 접속할 이름. 인증서 SAN 에 들어가므로 실제 접속에 쓰는 이름을
# 적어야 한다. 비워 두면 weed.<도메인> 을 추정해 쓴다.
WEED_HOSTNAME="weed.example.internal"
# 비워 두면 install.sh 가 무작위 생성해 /opt/weed/weed.env(0600)에 저장한다.
# 공개 저장소에 기본 비밀번호를 적어두면 그대로 운영에 들어가므로 비워 둔다.
WEED_ROOT_USER="uipathadmin"
WEED_ROOT_PASSWORD=""
WEED_HOST_IP=""
# 호스트에서 노출할 S3 API(HTTPS) 포트 (기본 8333). 컨테이너 안의 S3 게이트웨이는 8333 그대로다.
# 21-seaweedfs 에는 아직 install.sh 가 없어 지금은 번들의 BUNDLE-INFO 표기에만 쓰인다.
# compose 템플릿의 __SEAWEEDFS_S3_PORT__ 는 앞으로 작성할 install.sh 가 치환한다(21-seaweedfs/README.md 5절).
SEAWEEDFS_S3_PORT="8333"

#--- Harbor (30-harbor) ------------------------------------------------
# 접속 이름은 위 HARBOR_HOSTNAME 을 그대로 쓴다.
# 포트는 변수로 두지 않는다. HTTPS 443 고정이며 HTTPS 로만 쓴다(https://<HARBOR_HOSTNAME>).
# 80 은 HTTPS 로 리다이렉트만 한다. http:// 주소나 insecure-registries 로 붙이지 않는다
# (30-harbor/README.md 2절).
# 아래 둘을 비워 두면 install.sh 가 무작위 생성한다(Harbor12345 를 쓰지 않는다).
HARBOR_ADMIN_PASSWORD=""
HARBOR_DB_PASSWORD=""

#--- PostgreSQL (80-postgresql) ---------------------------------------
# 호스트 데이터 경로. 별도 디스크/LVM을 마운트한 경로를 지정한다.
# 컨테이너의 /var/lib/postgresql/data 에 마운트되며 실제 PGDATA 는 하위 pgdata 이다.
PG_DATA_DIR="/data/postgresql"
# 인증서 SAN 에 들어간다. 비워 두면 postgres[.도메인] 을 추정해 쓴다.
PG_HOSTNAME="postgres.example.internal"
# 비워 두면 install.sh 가 무작위 생성해 /opt/postgresql/postgres.env(0600)에 저장한다.
PG_PASSWORD=""
PG_HOST_IP=""
# 호스트에서 노출할 포트 (기본 5432). 컨테이너 안의 PostgreSQL 은 5432 그대로다.
POSTGRES_PORT="5432"

#--- MSSQL (70-mssql) -------------------------------------------------
# 호스트 데이터 경로. 별도 디스크/LVM을 마운트한 경로를 지정한다.
# 컨테이너의 /var/opt/mssql 에 마운트된다.
MSSQL_DATA_DIR="/data/mssql"
# 비워 두면 무작위 생성한다(SQL Server 비밀번호 정책을 만족하는 값).
MSSQL_SA_PASSWORD=""
# 에디션. 운영은 Standard/Enterprise 가 필요하다. 평가용은 Developer.
MSSQL_PID="Developer"
# 호스트에서 노출할 포트 (기본 1433). 컨테이너 안의 SQL Server 는 1433 그대로다.
MSSQL_PORT="1433"

#--- Redis OSS (45-redis) ----------------------------------------------
# 단일 노드 Redis 데이터 디렉터리. 별도 디스크/LVM 경로 권장.
REDIS_DATA_DIR="/data/redis"
# 클라이언트가 접속할 DNS 이름과 서버 인터페이스 IP.
REDIS_HOSTNAME="redis.example.internal"
REDIS_HOST_IP=""
# 비워 두면 install.sh 가 안전한 무작위 비밀번호를 생성한다.
# 직접 지정할 때는 영문자/숫자/밑줄/하이픈 32~128자로 설정한다.
REDIS_PASSWORD=""
# 호스트에서 노출할 TLS 포트 (기본 6379).
REDIS_PORT="6379"

#--- Ollama 임베딩 (85-ollama-embedding) -------------------------------
# nginx(Bearer 키 검사)를 노출할 호스트 포트 (기본 80). HTTP 평문이다.
OLLAMA_EMBED_PORT="80"
# 비워 두면 install.sh 가 sk-<hex 32자> 를 생성해
# /opt/ollama-embedding/ollama-embedding.env(0600)에 저장하고 설치 끝에 한 번 출력한다.
# 여기에 적은 키는 번들에 그대로 실리므로 자동 생성을 권장한다.
# 직접 지정할 때는 영문자·숫자·`.`·`_`·`-` 20~39자로 설정한다
# (40자 이상이면 nginx map 해시 기본 버킷 64바이트를 넘어 nginx 가 기동하지 않는다).
# `sudo OLLAMA_EMBED_API_KEY=... ./install.sh` 로 넘긴 값을 덮지 않도록 확장식으로 둔다.
OLLAMA_EMBED_API_KEY="${OLLAMA_EMBED_API_KEY:-}"

#--- 인증서 (05-certs) -------------------------------------------------
# 사내 CA 하나로 아래 서비스들의 인증서를 발급한다.
# 비워 둔 서비스는 발급을 건너뛴다.
#
# UiPath Automation Suite 의 FQDN. 와일드카드(*.<fqdn>)도 함께 발급된다.
# AS 는 alm.<fqdn>, monitoring.<fqdn> 같은 하위 이름을 쓰기 때문이다.
AS_FQDN="as.example.internal"
AS_LB_IP=""

# MSSQL / MinIO / Redis 접속 이름. 인증서 CN·SAN 에 들어간다.
# SQL Server 는 CN 을 보는 클라이언트가 있어 접속에 쓰는 이름과 같아야 한다.
MSSQL_HOSTNAME="mssql.example.internal"
MSSQL_HOST_IP=""

# CA 이름. 배포된 CA 를 식별할 때 쓰인다.
CA_CN="Vanilla K8s Internal CA"
CERT_ORG="Vanilla K8s"

# SQL Server 암호화 강제. 1 로 두면 암호화를 지원하지 않는 기존 클라이언트가
# 전부 끊긴다. 기본은 0(클라이언트가 선택).
MSSQL_FORCE_ENCRYPTION="0"
