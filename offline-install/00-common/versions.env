#---------------------------------------------------------------------
# 오프라인 번들 버전 핀 (single source of truth)
#
# 모든 build-bundle.sh / install.sh 가 이 파일을 source 한다.
# 여기 적힌 산출물 전부 2026-09-22 에 실제 접근 가능함을 확인했다
# (00-common/verify-urls.sh 통과 = 27/27).
#
# 버전을 바꿀 때는 반드시 verify-urls.sh 를 먼저 통과시킬 것.
# 업스트림이 배포를 내리는 일이 실제로 발생한다(아래 MinIO 사례).
#
# 방침: 운영 중인 기존 클러스터와 동일 버전으로 맞춘다.
#       containerd.io 2.3.5 / kubernetes-cni 1.9.1 / csi-driver-nfs v4.13.4 /
#       external-snapshotter v8.6.0 / Harbor v2.15.2 는 해당 환경에서
#       실제로 가동 중인 조합이다.
#---------------------------------------------------------------------

#--- 사이트별 설정 (내부 IP·사내 호스트명) ----------------------------
# 환경마다 다르고 공개 저장소에 올릴 수 없는 값은 site.env 로 분리했다.
# site.env 는 .gitignore 대상이며, 없으면 site.env.example 로 대체하고 경고한다.
#
#   cp 00-common/site.env.example 00-common/site.env   # 최초 1회
#
# 여기서 정의되는 값: SITE_PRIVATE_CIDR / NFS_SERVER_HOST /
#                     HARBOR_HOSTNAME / HARBOR_PRIVATE_IP /
#                     SITE_REACHABILITY_HOST / SITE_REACHABILITY_PORT
_VE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_VE_DIR}/site.env" ]]; then
    source "${_VE_DIR}/site.env"
elif [[ -f "${_VE_DIR}/site.env.example" ]]; then
    source "${_VE_DIR}/site.env.example"
    echo "[versions.env] WARN site.env 가 없어 site.env.example 의 예시 값을 쓴다." >&2
    echo "[versions.env]      cp 00-common/site.env.example 00-common/site.env 후 값을 채울 것." >&2
else
    echo "[versions.env] FATAL site.env / site.env.example 을 찾을 수 없다: ${_VE_DIR}" >&2
    return 1 2>/dev/null || exit 1
fi

#--- 대상 OS -----------------------------------------------------------
# 지원: Ubuntu 22.04(jammy), 24.04(noble) / amd64 전용
SUPPORTED_CODENAMES="jammy noble"
BUNDLE_ARCH="amd64"

#--- Kubernetes (deb: pkgs.k8s.io) ------------------------------------
K8S_MINOR="v1.36"                        # apt 저장소 채널
K8S_VERSION="1.36.4"                     # kubeadm --kubernetes-version 에 쓰는 값
K8S_PKG_VERSION="1.36.4-1.1"             # kubeadm / kubelet / kubectl deb
CRI_TOOLS_PKG_VERSION="1.36.0-1.1"
KUBERNETES_CNI_PKG_VERSION="1.9.1-1.1"
K8S_APT_REPO="https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb"
K8S_APT_KEY_URL="${K8S_APT_REPO}/Release.key"

#--- 컨테이너 런타임 ---------------------------------------------------
# containerd 는 Docker 공식 저장소의 containerd.io deb 를 쓴다.
#
# 왜 GitHub tarball 이 아니라 deb 인가:
#   1) 이 노드에는 docker 도 설치된다(Harbor/MinIO/HAProxy 컨테이너용).
#      docker-ce deb 가 containerd.io 를 의존하므로, tarball 로 containerd 를
#      깔면 docker 설치 시 containerd.io 가 덧씌워져 버전이 갈린다.
#   2) containerd.io deb 하나가 containerd + ctr + containerd-shim-runc-v2 +
#      runc 를 모두 제공한다(dpkg -L 로 실측 확인). 별도 runc 산출물이 불필요.
#   3) 운영 중인 기존 노드가 정확히 이 조합으로 동작한다.
CONTAINERD_VERSION="2.3.5"
CONTAINERD_DEB_REVISION="1"
RUNC_VERSION="1.5.1"                     # containerd.io deb 포함. 별도 다운로드 없음.

# CNI 플러그인은 kubernetes-cni deb 가 /opt/cni/bin 에 설치한다(dpkg -S 로 확인).
# Cilium 이 요구하는 loopback 등도 여기서 제공되므로 별도 tarball 불필요.
CNI_PLUGINS_VERSION="1.9.1"

#--- Docker (Harbor / MinIO / HAProxy 컨테이너 구동용) -----------------
DOCKER_VERSION="29.8.1"
DOCKER_DEB_REVISION="1"
# 주의: docker-ce / docker-ce-cli 의 apt 버전 문자열에는 epoch "5:" 가 붙는다.
#       (docker-ce = 5:29.8.1-1~ubuntu.24.04~noble)
#       epoch 를 빼고 apt-get download 를 호출하면
#       "Version ... was not found" 로 실패한다. deb 파일명에는 epoch 가 없다.
#       containerd.io / buildx / compose 에는 epoch 가 없다.
DOCKER_DEB_EPOCH="5:"
DOCKER_BUILDX_VERSION="0.37.1"
DOCKER_COMPOSE_VERSION="5.5.1"
DOCKER_REPO="https://download.docker.com/linux/ubuntu"
DOCKER_APT_KEY_URL="${DOCKER_REPO}/gpg"

#--- 도구 --------------------------------------------------------------
# helm: 요구사항 3.8+ -> 3.x 최신. (helm 4.x 도 나와 있으나 요구사항 밖)
HELM_VERSION="v3.22.0"
HELM_URL="https://get.helm.sh/helm-${HELM_VERSION}-linux-${BUNDLE_ARCH}.tar.gz"

# podman: 요구사항 4.9+ 를 양쪽 OS 에서 동일하게 만족시키려면 정적 빌드가 필요하다.
#   - 22.04 배포판 3.4.4 / Kubic 4.6.2 -> 둘 다 4.9+ 미달 (공식 경로로 도달 불가)
#   - 24.04 배포판 4.9.3               -> 충족하지만 OS 간 버전이 갈린다
# 결정: 양쪽 모두 podman-static 사용. 의존성이 없어 에어갭에 유리하다.
# 서드파티 빌드(mgoltzsche)이며 GPG 서명(.asc)이 함께 배포된다.
PODMAN_STATIC_VERSION="v5.8.7"
PODMAN_STATIC_URL="https://github.com/mgoltzsche/podman-static/releases/download/${PODMAN_STATIC_VERSION}/podman-linux-${BUNDLE_ARCH}.tar.gz"
PODMAN_STATIC_ASC_URL="${PODMAN_STATIC_URL}.asc"

#--- CNI: Cilium ------------------------------------------------------
# Cilium 1.20 문서가 k8s 1.33~1.36 e2e 지원을 명시(1.36 포함).
# kube-proxy 는 유지한다(eBPF 대체 안 함) - 단일 노드 검증 단순화 목적.
CILIUM_VERSION="1.20.2"
CILIUM_CLI_VERSION="v0.20.0"
CILIUM_CHART_URL="https://helm.cilium.io/cilium-${CILIUM_VERSION}.tgz"
CILIUM_CLI_URL="https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${BUNDLE_ARCH}.tar.gz"
POD_CIDR="10.244.0.0/16"                 # 기존 클러스터와 동일
SERVICE_CIDR="10.96.0.0/12"

#--- CSI: NFS ---------------------------------------------------------
# NFS 서버는 클러스터 밖에 두고, 각 노드는 클라이언트+프로비저너만 올린다.
# 서버 주소(NFS_SERVER_HOST)는 site.env 에서 정의한다.
CSI_DRIVER_NFS_VERSION="v4.13.4"
EXTERNAL_SNAPSHOTTER_VERSION="v8.6.0"
CSI_DRIVER_NFS_SRC_URL="https://github.com/kubernetes-csi/csi-driver-nfs/archive/refs/tags/${CSI_DRIVER_NFS_VERSION}.tar.gz"
EXTERNAL_SNAPSHOTTER_SRC_URL="https://github.com/kubernetes-csi/external-snapshotter/archive/refs/tags/${EXTERNAL_SNAPSHOTTER_VERSION}.tar.gz"

NFS_EXPORT_PATH="/data/nfs"
# 주의: mountOptions 에 noresvport 를 넣지 말 것.
# export 에 insecure 가 없으면 서버가 비특권 포트를 거부해
# mount.nfs: Operation not permitted (exit 32) 로 PVC 가 Pending 이 된다.
# mountOptions 는 불변 필드라 고치려면 StorageClass 를 삭제·재생성해야 한다.
NFS_MOUNT_OPTIONS="nfsvers=4.1,hard,timeo=600,retrans=2"

#--- Harbor -----------------------------------------------------------
# 내장 PostgreSQL(harbor-db)을 쓰므로 별도 DB 구성은 불필요.
HARBOR_VERSION="v2.15.2"
HARBOR_OFFLINE_URL="https://github.com/goharbor/harbor/releases/download/${HARBOR_VERSION}/harbor-offline-installer-${HARBOR_VERSION}.tgz"

#--- MinIO ------------------------------------------------------------
# 중요: MinIO 오픈소스(server/mc/KES)는 아카이브되어 dl.min.io 가 410 Gone 을
#       반환한다. 바이너리 배포 경로가 사라졌고 GitHub 릴리스에도 에셋이 없다.
#       현재 유일하게 살아 있는 경로가 quay.io 컨테이너 이미지다.
#       아래 태그/다이제스트는 기존 운영 환경(infra-01)에서 가동 중인 것과 동일하다.
#       보안 업데이트는 더 이상 제공되지 않는다.
MINIO_IMAGE="quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z"
MINIO_IMAGE_DIGEST="sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e"
MINIO_MC_IMAGE="quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z"
MINIO_REGION="ap-northeast-2"

#--- HAProxy ----------------------------------------------------------
# ingress(80/443/15021) L4 패스스루 전용. 단일 노드라 API 서버(6443) LB 는 불필요.
HAPROXY_IMAGE="haproxy:3.4.4"

#--- 사내 인프라 (에어갭 타깃이 사설망으로 접근하는 대상) --------------
# Harbor 는 이미 구축되어 운영 중이다. 이 번들은 Harbor 를 다시 설치하지 않는다.
# 에어갭 노드는 사설 IP 로 접근하되 TLS SAN 때문에 호스트명을 써야 하므로
# /etc/hosts 에 아래 매핑을 넣는다(공인 DNS 는 공인 IP 를 반환하므로 차단됨).
# HARBOR_HOSTNAME / HARBOR_PRIVATE_IP 는 site.env 에서 정의한다.

#--- 커스텀 이미지 게시 (docker.io/javaos74) ---------------------------
# 업스트림에 그대로 존재하지 않아 직접 빌드해야 하는 이미지들이다.
# 00-common/publish-images.sh 가 이 값을 읽는다.
#
#   mssql-fts        : 공식 mcr.microsoft.com/mssql/server 이미지에는
#                      Full-Text Search 가 들어 있지 않다(실측). UiPath AS 는
#                      FTS 를 요구하므로 커스텀 이미지가 반드시 필요하다.
#   postgres-jammy   : 공식 postgres 는 Debian bookworm 기반이다.
#                      베이스 OS 를 jammy 로 맞춰야 할 때만 쓴다.
PUBLISH_NAMESPACE_DEFAULT="javaos74"

# SQL Server 2022. 본체와 FTS 의 버전이 반드시 같아야 한다(실측 조합).
# 빌드 레시피는 70-mssql/fts-image/ 에 있다(Dockerfile + build-image.sh).
# 이미지 하나만 따로 판정하려면:
#   70-mssql/fts-image/verify-fts-image.sh <이미지> --smoke
MSSQL_VERSION="16.0.4265.3"
MSSQL_FTS_PKG_VERSION="16.0.4265.3-1"
MSSQL_BASE_IMAGE="mcr.microsoft.com/mssql/server:2022-latest"
# 베이스 이미지를 다이제스트로 핀한다. 2022-latest 태그는 움직이므로
# 태그만 믿으면 FTS 패키지 버전과 어긋날 수 있다.
MSSQL_BASE_IMAGE_DIGEST="sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89"
# 태그는 두 개를 올린다.
#   2022-<버전> : 번들이 참조하는 고정 태그
#   2022        : 사람이 쓰는 짧은 태그
MSSQL_FTS_TAGS="2022-${MSSQL_VERSION} 2022"
# 게시 완료(2026-09-23). public. 번들은 태그가 아니라 이 다이제스트로 핀한다.
# 익명 pull 가능함을 로그인 없는 호스트에서 확인했다.
MSSQL_FTS_IMAGE="docker.io/${PUBLISH_NAMESPACE_DEFAULT}/mssql-fts:2022-${MSSQL_VERSION}"
# 이 값은 Hub 태그 목록에 나오지 않는다. 고아 매니페스트라서가 아니다.
# 태그 2022-16.0.4265.3 이 가리키는 것은 OCI 인덱스(sha256:22cefd4d...)이고,
# 아래 값은 그 인덱스의 **linux/amd64 자식 매니페스트**다(실측).
#   sha256:22cefd4d...  application/vnd.oci.image.index.v1+json
#     ├─ linux/amd64      sha256:6ef6c90c...   <- 아래 핀
#     └─ unknown/unknown  sha256:7f94c1e3...   <- buildx attestation
# 인덱스가 태그로 참조되는 한 자식도 GC 되지 않는다. 그리고 번들은
# skopeo copy -> docker-archive 로 단일 이미지를 받으므로 인덱스가 아니라
# 플랫폼 단일 매니페스트를 핀하는 것이 맞다.
MSSQL_FTS_IMAGE_DIGEST="sha256:6ef6c90c4220b49a452174d1288ae964649581b713286c128483e58c46bc7ab7"
# 2026-09-23 재검증: 위 다이제스트 이미지를 실제로 띄워 확인했다.
#   ISFULLTEXTINSTALLED 1 / FTSSERVICEINSTALLED 1 / FULLTEXTLANGUAGES 53
#   PRODUCTVERSION 16.0.4265.3 (RTM-CU26, KB5093420) / CONTAINS 질의 정상
# 즉 "FTS 가 빠졌다"는 현장 보고는 이 이미지가 아니라 공식 MCR 이미지를
# 배포한 경우다. 공식 이미지는 IsFullTextInstalled=0 이다(아래 CU25 항목).
#
# CU25 고정이 필요한 현장용 변형. 엔진을 CU25 로 둔 채 FTS 만 넣은 이미지다.
# 빌드/검증/게시 완료(2026-09-23). public. 3.22GB.
#   BASE_IMAGE=mcr.microsoft.com/mssql/server:2022-CU25-ubuntu-22.04 \
#     MSSQL_PKG_VERSION=16.0.4255.1-8 ./build-image.sh
MSSQL_CU25_BASE_IMAGE="mcr.microsoft.com/mssql/server:2022-CU25-ubuntu-22.04"
MSSQL_CU25_BASE_DIGEST="sha256:e07b9699a2b749969f19d86563ceeea22bd3a69f7f1db85a8d1ac4bdaf0c6f56"
# CU25 의 FTS 리비전은 -1 이 아니라 -8 이다(실측: apt-cache madison).
MSSQL_CU25_FTS_PKG_VERSION="16.0.4255.1-8"
MSSQL_CU25_VERSION="16.0.4255.1"
# floating 태그 `2022` 는 일부러 건드리지 않았다. 그 태그는 CU26 을 가리킨다.
# CU25 를 거기에 덮으면 `:2022` 를 받는 모든 곳이 조용히 내려앉는다.
MSSQL_CU25_FTS_TAGS="2022-${MSSQL_CU25_VERSION} 2022-cu25"
MSSQL_CU25_FTS_IMAGE="docker.io/${PUBLISH_NAMESPACE_DEFAULT}/mssql-fts:2022-${MSSQL_CU25_VERSION}"
MSSQL_CU25_FTS_IMAGE_DIGEST="sha256:2fb0c59c51fb7951728b4ac66a3fbbefd6cf7fd61013f1b52f8fb20051639b11"
# 게시 후 검증: 로그인 기록이 없는 호스트에서 다이제스트로 익명 pull 한 뒤
# 실제로 띄워 확인했다.
#   ISFULLTEXTINSTALLED 1 / FTSSERVICEINSTALLED 1 / FULLTEXTLANGUAGES 53
#   PRODUCTVERSION 16.0.4255.1 (RTM-CU25, KB5081477) / CONTAINS 질의 정상
#
# 이 이미지로 번들을 만들려면 아래 두 줄을 바꾼다(기본은 CU26 이다).
#   MSSQL_SERVER_IMAGE="${MSSQL_CU25_FTS_IMAGE}"
#   MSSQL_SERVER_IMAGE_DIGEST="${MSSQL_CU25_FTS_IMAGE_DIGEST}"
#
# 참고 — 공식 CU25 베이스 이미지를 그대로 띄운 결과(실측):
#   ISFULLTEXTINSTALLED 0 / FTSSERVICEINSTALLED 0 / FULLTEXTLANGUAGES 0
#   PRODUCTVERSION 16.0.4255.1 (RTM-CU25, KB5081477)
# 주의: 베이스 이미지 env 에 MSSQL_PID=developer 가 박혀 있다. Developer 는
#       평가용이다. AS 프로덕션은 Standard/Enterprise 를 요구하므로 실행 시
#       MSSQL_PID 환경변수로 덮어쓸 것.

# PostgreSQL. 운영 중인 infra-01 는 공식 bookworm 이미지(16.10)를 쓰고,
# jammy 기반 자체 빌드는 16.15 다. 둘은 용도가 다르므로 함께 기록한다.
POSTGRES_OFFICIAL_IMAGE="postgres:16.10-bookworm"
POSTGRES_OFFICIAL_DIGEST="sha256:38471f330eb885e04de130b768d6db4e10469e2311879c7e5c699f6d2d8a1c74"
POSTGRES_JAMMY_VERSION="16.15"
POSTGRES_JAMMY_PKG_VERSION="16.15-1.pgdg22.04+2"
POSTGRES_JAMMY_TAGS="${POSTGRES_JAMMY_VERSION} 16"
# 게시 완료(2026-09-23). public.
POSTGRES_JAMMY_IMAGE="docker.io/${PUBLISH_NAMESPACE_DEFAULT}/postgres-jammy:${POSTGRES_JAMMY_VERSION}"
POSTGRES_JAMMY_IMAGE_DIGEST="sha256:338bd7cab6345bc5238f0637aafc58148ed67a10e042a3e2dd0ce2c2ecab248d"

#--- MSSQL (70-mssql) -------------------------------------------------
# UiPath AS 는 외부 SQL Server 를 요구하고 Full-Text Search 가 필요하다.
# 공식 mcr 이미지에는 FTS 가 없어 직접 빌드한 이미지를 쓴다(5절 게시 참고).
# 에어갭 번들은 이 이미지를 tar 로 담는다.
MSSQL_SERVER_IMAGE="${MSSQL_FTS_IMAGE}"
MSSQL_SERVER_IMAGE_DIGEST="${MSSQL_FTS_IMAGE_DIGEST}"
MSSQL_PORT="1433"
# UiPath AS 가 요구하는 데이터 정렬(collation). 다르면 설치 단계에서 거부된다.
MSSQL_COLLATION="SQL_Latin1_General_CP1_CI_AS"
# 에디션. 이미지에는 developer 가 박혀 있다(평가용).
# 운영은 Standard/Enterprise 를 요구하므로 런타임에 덮어쓸 수 있게 둔다.
MSSQL_PID_DEFAULT="Developer"
# sqlcmd 경로. 이미지 안에 있지만 PATH 에는 없다(실측).
MSSQL_SQLCMD="/opt/mssql-tools18/bin/sqlcmd"

#--- PostgreSQL (80-postgresql) ---------------------------------------
# 기본은 업스트림 공식 이미지다. 업스트림이 유지·보안 갱신을 계속하므로
# 자체 빌드보다 낫다. 베이스 OS 를 jammy 로 맞춰야 하는 제약이 있을 때만
# POSTGRES_IMAGE 를 POSTGRES_JAMMY_IMAGE 로 바꾼다.
POSTGRES_IMAGE="${POSTGRES_OFFICIAL_IMAGE}"
POSTGRES_IMAGE_DIGEST="${POSTGRES_OFFICIAL_DIGEST}"
POSTGRES_PORT="5432"
