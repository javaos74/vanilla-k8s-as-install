# etcd 스냅샷 — 클러스터 전체 Secret(평문)이 들어있다. 절대 커밋 금지
backups/
*.db

# 대용량 바이너리 (116MB, GitHub 100MB 제한 초과)
uipathctl

# 개인키 / 자격증명
*.key
*.pem
*.env

# 리다이렉션 전 원본 로그
*.orig

# 실행 로그·진단 덤프. 재현에 쓸모가 없고 토큰·내부 호스트명이 섞인다
*.log
log-*.txt
join-*.txt
*-handshake.txt

# 타임스탬프 백업 부산물
*.bak
*.bak.[0-9]*
*.bak.[0-9]*.yaml

# 에이전트 로컬 설정 — 실제 IP/인스턴스 ID 보유
.kiro/
.omc/

# 저장소 루트의 사이트별 산출물 — 클러스터 접속 정보·실제 입력값·사내 CA
#   kube_config        : kubeconfig (클러스터 관리자 인증서/토큰)
#   input-myrobot.json : UiPath AS 실제 입력(호스트명·비밀번호)
#   *.crt.zip          : 내보낸 인증서 묶음
/kube_config
/input-myrobot.json
/*.crt.zip

# 치환 전 원본 백업
_local/

# macOS 부산물
.DS_Store
